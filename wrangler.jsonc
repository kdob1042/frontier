{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frontier-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "local",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": "",
    "AI_ENABLED": "false",
    "DAILY_ENABLED": "false",
    "OPENAI_MODEL": "",
    "VISION_INPUT_TOKEN_BOUND": "0",
    "AUDIO_MICRO_USD_PER_SECOND": "0",
    "DAILY_BUDGET_MICRO_USD": "0",
    "MONTHLY_BUDGET_MICRO_USD": "0",
    "INPUT_MICRO_USD_PER_TOKEN": "0",
    "OUTPUT_MICRO_USD_PER_TOKEN": "0",
  },
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "frontier-media-local" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "frontier-local", "migrations_dir": "migrations" },
  ],
  "workflows": [
    { "binding": "MEDIA_WORKFLOW", "name": "frontier-media-local", "class_name": "MediaWorkflow" },
    {
      "binding": "HARVEST_WORKFLOW",
      "name": "frontier-harvest-local",
      "class_name": "HarvestWorkflow",
    },
    { "binding": "DAILY_WORKFLOW", "name": "frontier-daily-local", "class_name": "DailyWorkflow" },
  ],
  "env": {
    "preview": {
      "name": "frontier-preview",
      "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "frontier-media-preview" }],
      "workers_dev": false,
      "triggers": { "crons": [] },
      "vars": {
        "ENVIRONMENT": "preview",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "OWNER_EMAIL": "",
        "AI_ENABLED": "false",
        "DAILY_ENABLED": "false",
        "OPENAI_MODEL": "",
        "VISION_INPUT_TOKEN_BOUND": "0",
        "AUDIO_MICRO_USD_PER_SECOND": "0",
        "DAILY_BUDGET_MICRO_USD": "0",
        "MONTHLY_BUDGET_MICRO_USD": "0",
        "INPUT_MICRO_USD_PER_TOKEN": "0",
        "OUTPUT_MICRO_USD_PER_TOKEN": "0",
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "frontier-preview", "migrations_dir": "migrations" },
      ],
      "workflows": [
        {
          "binding": "MEDIA_WORKFLOW",
          "name": "frontier-media-preview",
          "class_name": "MediaWorkflow",
        },
        {
          "binding": "HARVEST_WORKFLOW",
          "name": "frontier-harvest-preview",
          "class_name": "HarvestWorkflow",
        },
        {
          "binding": "DAILY_WORKFLOW",
          "name": "frontier-daily-preview",
          "class_name": "DailyWorkflow",
        },
      ],
    },
    "production": {
      "name": "frontier",
      "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "frontier-media-production" }],
      "workers_dev": false,
      "triggers": { "crons": ["0 23 * * *"] },
      "vars": {
        "ENVIRONMENT": "production",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "OWNER_EMAIL": "",
        "AI_ENABLED": "false",
        "DAILY_ENABLED": "false",
        "OPENAI_MODEL": "",
        "VISION_INPUT_TOKEN_BOUND": "0",
        "AUDIO_MICRO_USD_PER_SECOND": "0",
        "DAILY_BUDGET_MICRO_USD": "0",
        "MONTHLY_BUDGET_MICRO_USD": "0",
        "INPUT_MICRO_USD_PER_TOKEN": "0",
        "OUTPUT_MICRO_USD_PER_TOKEN": "0",
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "frontier-production", "migrations_dir": "migrations" },
      ],
      "workflows": [
        {
          "binding": "MEDIA_WORKFLOW",
          "name": "frontier-media-production",
          "class_name": "MediaWorkflow",
        },
        {
          "binding": "HARVEST_WORKFLOW",
          "name": "frontier-harvest",
          "class_name": "HarvestWorkflow",
        },
        {
          "binding": "DAILY_WORKFLOW",
          "name": "frontier-daily-production",
          "class_name": "DailyWorkflow",
        },
      ],
    },
  },
}
