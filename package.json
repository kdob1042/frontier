{
  "name": "frontier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev --local --port 8792",
    "build:web": "vite build",
    "build": "npm run check && npm run build:web && wrangler deploy --dry-run --outdir dist-worker --env=\"\"",
    "types": "wrangler types --include-runtime false --strict-vars false",
    "check": "tsc --noEmit",
    "migrate": "wrangler d1 migrations apply DB --local",
    "test": "node --import tsx --test test/*.test.*",
    "test:integration": "node --import tsx scripts/integration.mjs",
    "test:browser": "node --import tsx scripts/browser.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.0.0",
    "htmlparser2": "^12.0.0",
    "jose": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.9",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.145.0"
  }
}
